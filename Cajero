void retirar(Cuenta *c) {
    float monto;
    limpiarPantalla();
    cout << "Cuanto quieres retirar?" << endl;
    cin >> monto;
    try {
        if (cin.fail()) throw "Eso no es un numero.";
        if (monto <= 0) throw "Monto invalido.";
        if (monto > c->saldo) throw "No tienes suficiente saldo.";

        c->saldo -= monto;
        cout << fixed << setprecision(2);
        cout << "Retiro listo. Nuevo saldo: $" << c->saldo << endl;

        cin.ignore(); cin.get();
    } catch (const char* msg) {
        cout << "Error: " << msg << endl;
        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        } else {
            cin.ignore();
        }
        cin.get();
    }
}
