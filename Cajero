#include <iostream>
#include <cstdlib> 
#include <iomanip> 
#include <limits> 

using namespace std;

struct Cuenta {
    int numeroCuenta;
    float saldo;
};

// Prototipos de funciones
void limpiarPantalla();
void mostrarMenu();
void consultarSaldo(Cuenta *c);
void depositar(Cuenta *c);
void retirar(Cuenta *c);
void transferir(Cuenta *origen, Cuenta cuentas[], int n);
int buscarCuenta(Cuenta cuentas[], int n, int numeroBuscado);

int main() {
    const int N = 3;
    // Saldos iniciales
    Cuenta cuentas[N] = {
        {1001, 1.00}, 
        {1002, 500.00}, 
        {1003, 1000.00} 
    };
    
    int numeroIngresado, indice, opcion;
    Cuenta *cuentaActual = NULL; 
    bool cajeroEncendido = true; 

    while (cajeroEncendido) {
        bool usuarioValido = false;
        cuentaActual = NULL;

        limpiarPantalla();
        cout << "Bienvenido a BANCO EL MEJOR" << endl;
        
        do {
            cout << "Ingresa tu numero de cuenta para iniciar (o 0 para apagar):" << endl;
            if (!(cin >> numeroIngresado)) { 
                cout << "Entrada no valida. Solo numeros." << endl;
                cin.clear();
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                continue;
            }

            if (numeroIngresado == 0) {
                cout << "Apagando sistema..." << endl;
                return 0;
            }

            indice = buscarCuenta(cuentas, N, numeroIngresado);

            if (indice != -1) {
                cuentaActual = &cuentas[indice];
                usuarioValido = true;
                cout << "Hola usuario " << cuentaActual->numeroCuenta << endl;
                cout << "Presiona Enter para entrar al menu...";
                cin.ignore(); cin.get(); 
            } else {
                cout << "Cuenta no encontrada." << endl;
            }
        } while (!usuarioValido);

        bool sesionActiva = true;
        do {
            limpiarPantalla();
            mostrarMenu();
            cout << "Elige una opcion: ";
            cin >> opcion;

            switch (opcion) {
                case 1:
                    consultarSaldo(cuentaActual); 
                    break;
                case 2:
                    depositar(cuentaActual);
                    break;
                case 3:
                    retirar(cuentaActual);
                    break;
                case 4:
                    transferir(cuentaActual, cuentas, N);
                    break;
                case 5:
                    cout << "Cerrando sesion..." << endl;
                    cout << "Presiona Enter...";
                    cin.ignore(); cin.get();
                    sesionActiva = false; 
                    break;
                case 6:
                    cout << "Gracias por usar BANCO EL MEJOR. Apagando..." << endl;
                    cajeroEncendido = false; 
                    sesionActiva = false;    
                    break;
                default:
                    cout << "Opcion no valida." << endl;
                    cout << "Presiona Enter...";
                    cin.ignore(); cin.get();
            }
        } while (sesionActiva);
    }

    return 0;
}

void limpiarPantalla() {
    #ifdef _WIN32
        system("cls"); 
    #else
        system("clear"); 
    #endif
}

void mostrarMenu() {
    cout << "BANCO EL MEJOR - MENU PRINCIPAL" << endl;
    cout << "1. Consultar Saldo" << endl;
    cout << "2. Depositar" << endl;
    cout << "3. Retirar" << endl;
    cout << "4. Transferir" << endl;
    cout << "5. Cerrar Sesion" << endl;
    cout << "6. Apagar Cajero" << endl;
}

int buscarCuenta(Cuenta cuentas[], int n, int numeroBuscado) {
    for (int i = 0; i < n; i++) {
        if (cuentas[i].numeroCuenta == numeroBuscado) {
            return i;
        }
    }
    return -1;
}

void consultarSaldo(Cuenta *c) {
    limpiarPantalla();
    cout << fixed << setprecision(2); 
    cout << "Tu saldo actual es: $" << c->saldo << endl;
    cout << "Presiona Enter para volver...";
    cin.ignore(); cin.get();
}

void depositar(Cuenta *c) {
    float monto;
    limpiarPantalla();
    cout << "Cuanto quieres depositar?" << endl;
    cin >> monto;

    try {
        if (cin.fail()) throw "Eso no es un numero.";
        if (monto <= 0) throw "El monto debe ser mayor a 0.";

        c->saldo += monto;
        
        cout << fixed << setprecision(2);
        cout << "Listo. Nuevo saldo: $" << c->saldo << endl;
        
        cin.ignore(); cin.get(); 

    } catch (const char* msg) {
        cout << "Error: " << msg << endl;
        
        if (cin.fail()) {
            cin.clear(); 
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        } else {
            cin.ignore(); 
        }
        cin.get();
    }
}

void retirar(Cuenta *c) {
    float monto;
    limpiarPantalla();
    cout << "Cuanto quieres retirar?" << endl;
    cin >> monto;

    try {
        if (cin.fail()) throw "Eso no es un numero.";
        if (monto <= 0) throw "Monto invalido.";
        if (monto > c->saldo) throw "No tienes suficiente saldo.";

        c->saldo -= monto;

        cout << fixed << setprecision(2);
        cout << "Retiro listo. Nuevo saldo: $" << c->saldo << endl;

        cin.ignore(); cin.get();

    } catch (const char* msg) {
        cout << "Error: " << msg << endl;
        
        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        } else {
            cin.ignore();
        }
        cin.get();
    }
}

void transferir(Cuenta *origen, Cuenta cuentas[], int n) {
    int cuentaDestinoID;
    float monto;
    
    limpiarPantalla();
    cout << "A que cuenta quieres transferir?" << endl;
    cin >> cuentaDestinoID;

    if (cin.fail()) {
        cin.clear(); cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Numero de cuenta invalido." << endl;
        cout << "Presiona Enter...";
        cin.get();
        return;
    }

    int indiceDestino = buscarCuenta(cuentas, n, cuentaDestinoID);

    if (indiceDestino == -1) {
        cout << "Esa cuenta no existe." << endl;
        cout << "Presiona Enter...";
        cin.ignore(); cin.get();
        return; 
    }

    if (cuentas[indiceDestino].numeroCuenta == origen->numeroCuenta) {
        cout << "No te puedes transferir a ti mismo." << endl;
        cout << "Presiona Enter...";
        cin.ignore(); cin.get();
        return;
    }

    cout << "Cuanto quieres transferir?" << endl;
    cin >> monto;

    try {
        if (cin.fail()) throw "Eso no es un numero.";
        if (monto <= 0) throw "Monto invalido.";
        if (monto > origen->saldo) throw "No tienes saldo suficiente.";

        origen->saldo -= monto;
        cuentas[indiceDestino].saldo += monto;

        cout << fixed << setprecision(2);
        cout << "Transferencia de $" << monto << " realizada con exito." << endl;
        cout << "Tu saldo quedo en: $" << origen->saldo << endl;

        cin.ignore(); cin.get();

    } catch (const char* msg) {
        cout << "Error: " << msg << endl;
        
        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        } else {
            cin.ignore();
        }
        cin.get();
    }
}
